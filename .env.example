# Modelo do arquivo .env — copie para .env e preencha os valores reais.
# O .env NUNCA vai para o Git (repositório público).

# Chave secreta do Django (gere uma nova em: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=
DEBUG=True

# Oracle Autonomous Database — usuário e senha do banco
ORACLE_USER=
ORACLE_PASSWORD=

# Alias do tnsnames.ora da wallet (ex.: modeloappdb_low)
ORACLE_DSN=modeloappdb_low

# Pasta da wallet descompactada (contém tnsnames.ora e ewallet.pem)
# Exemplo no Windows: C:\Users\seu_usuario\oracle_wallet
ORACLE_WALLET_DIR=

# Senha da wallet (a mesma usada ao baixar a wallet no OCI)
ORACLE_WALLET_PASSWORD=
